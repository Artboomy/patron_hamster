{
  "manifest_version": 3,
  "name": "Patreon Extractor Bridge V2",
  "version": "0.1.0",
  "description": "Bridge V2 dashboard and localhost messaging scaffold.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
