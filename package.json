{
  "name": "patron_hamster",
  "description": "Package to scrape Patreon/Pixiv fanbox content",
  "scripts": {
    "lint": "eslint src chrome-extension --cache --cache-location .cache/eslint/.eslintcache",
    "lint:debug": "eslint src chrome-extension --cache --cache-location .cache/eslint/.eslintcache --debug",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tsc/typecheck.tsbuildinfo",
    "test": "yarn run test:unit && yarn run test:extension-ui",
    "self-check": "echo '[self-check] 1/4 lint' && yarn run lint && echo '[self-check] 2/4 typecheck' && yarn run typecheck && echo '[self-check] 3/4 tests' && yarn run test && echo '[self-check] 4/4 bridge e2e' && yarn run test:bridge-e2e",
    "build": "tsc",
    "build:extension": "vite build --config chrome-extension/vite.config.ts",
    "build:extension:e2e": "vite build --config chrome-extension/vite.config.ts --mode bridge-e2e",
    "dev:extension": "vite build --watch --config chrome-extension/vite.config.ts",
    "test:unit": "vitest run --environment node test/**/*.test.ts",
    "test:extension-ui": "vitest --config chrome-extension/vite.config.ts run",
    "test:extension-ui:watch": "vitest --config chrome-extension/vite.config.ts",
    "test:bridge-e2e": "yarn run build && yarn run build:extension:e2e && node ./node_modules/@playwright/test/cli.js test --config playwright.bridge-e2e.config.ts",
    "test:bridge-e2e:headed": "yarn run build && yarn run build:extension:e2e && node ./node_modules/@playwright/test/cli.js test --config playwright.bridge-e2e.config.ts --headed",
    "ladle:extension": "cd chrome-extension && ladle serve",
    "ladle:extension:build": "cd chrome-extension && ladle build",
    "launch": "yarn run build && node dist/index.js",
    "toc:md": "yarn run build && node dist/generateTOCmd.js",
    "toc:html": "yarn run build && node dist/generateTOChtml.js",
    "gallery:html": "yarn run build && node dist/generateGalleryHtml.js",
    "epub": "yarn run build && node dist/scripts/epub.js",
    "local-bridge:start": "yarn run build && node dist/local-bridge/server.js",
    "local-bridge:self-test": "yarn run build && node dist/local-bridge/self-test.js"
  },
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.2",
    "axios": "^1.12.2",
    "cheerio": "^1.0.0",
    "epub-gen-memory": "1.1.2",
    "exiftool-vendored": "^29.1.0",
    "file-type": "^20.1.0",
    "marked": "^15.0.7",
    "minimist": "^1.2.8",
    "node-fetch": "^3.3.2",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "playwright": "^1.51.0",
    "playwright-extra": "^4.3.6",
    "playwright-extra-plugin-stealth": "^0.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rebrowser-playwright": "^1.49.1",
    "turndown": "^7.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@ladle/react": "^5.0.3",
    "@playwright/test": "1.51.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.11",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.13.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.7.0"
}
