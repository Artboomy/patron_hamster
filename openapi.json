      },
      "navigate": {
        "payloadSchema": "#/components/schemas/NavigatePayload",
        "resultSchema": "#/components/schemas/NavigateResult"
      },
      "getUrl": {
        "payloadSchema": "#/components/schemas/GetUrlPayload",
