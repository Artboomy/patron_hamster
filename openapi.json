      },
      "evaluate": {
        "payloadSchema": "#/components/schemas/EvaluatePayload",
        "resultSchema": "#/components/schemas/EvaluateResult"
      },
      "waitForSelector": {
        "payloadSchema": "#/components/schemas/WaitForSelectorPayload",
        "resultSchema": "#/components/schemas/WaitForSelectorResult"
      },
      "count": {
        "payloadSchema": "#/components/schemas/CountPayload",
        "resultSchema": "#/components/schemas/CountResult"
      },
      "click": {
        "payloadSchema": "#/components/schemas/ClickPayload",
        "resultSchema": "#/components/schemas/ClickResult"
      },
      "hover": {
        "payloadSchema": "#/components/schemas/HoverPayload",
        "resultSchema": "#/components/schemas/HoverResult"
      },
      "innerText": {
        "payloadSchema": "#/components/schemas/InnerTextPayload",
        "resultSchema": "#/components/schemas/InnerTextResult"
      },
      "scrollBy": {
        "payloadSchema": "#/components/schemas/ScrollByPayload",
        "resultSchema": "#/components/schemas/ScrollByResult"
      },
      "sleep": {
        "payloadSchema": "#/components/schemas/SleepPayload",
        "resultSchema": "#/components/schemas/SleepResult"
      },
      "listTabs": {
        "payloadSchema": "#/components/schemas/ListTabsPayload",
        "resultSchema": "#/components/schemas/ListTabsResult"
      },
      "activateTab": {
        "payloadSchema": "#/components/schemas/ActivateTabPayload",
        "resultSchema": "#/components/schemas/ActivateTabResult"
      }
    }
  }
}
